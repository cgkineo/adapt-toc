{
  "type": "object",
  "$schema": "http://json-schema.org/draft-04/schema",
  "id": "http://jsonschema.net",
  "globals": {
    "navigationToc": {
      "type": "string",
      "required": true,
      "default": "Open table of contents",
      "inputType": "Text",
      "validators": [],
      "translatable": true
    },
    "toc": {
      "type": "string",
      "required": true,
      "default": "Table of contents",
      "inputType": "Text",
      "validators": [],
      "translatable": true
    },
    "tocEnd": {
      "type": "string",
      "required": true,
      "default": "You have reached the end of the table of contents.",
      "inputType": "Text",
      "validators": [],
      "translatable": true
    },
    "tocContentObject": {
      "type": "string",
      "required": true,
      "default": "{{title}}. You have completed {{percentage}}%.",
      "inputType": "Text",
      "validators": [],
      "translatable": true
    },
    "optionalContent": {
      "type": "string",
      "required": true,
      "default": "Optional Content",
      "inputType": "Text",
      "validators": [],
      "translatable": true
    },
    "_navOrder": {
      "type": "number",
      "required": false,
      "default": 0,
      "title": "Navigation button order",
      "inputType": "Number",
      "validators": ["number"],
      "help": "Determines the order in which the button appears in the navigation bar. Defaults to 0."
    },
    "_showLabel": {
      "type": "boolean",
      "required": false,
      "default": true,
      "title": "Show navigation button label",
      "inputType": "Checkbox",
      "validators": [],
      "help": "Controls whether the navigation button label is displayed."
    },
    "navLabel": {
      "type": "string",
      "required": false,
      "default": "",
      "title": "Navigation bar label",
      "inputType": "Text",
      "validators": [],
      "translatable": true,
      "help": "The label for the navigation button. Defaults to the 'navigationToc' aria label if empty."
    },
    "_iconClasses": {
      "type": "string",
      "required": false,
      "default": "icon-menu",
      "title": "Navigation button icon",
      "inputType": "Text",
      "validators": [],
      "help": "CSS class for the navigation button icon. Defaults to 'icon-menu'."
    },
    "_navTooltip": {
      "type": "object",
      "title": "Table of Contents navigation tooltip",
      "properties": {
        "_isEnabled": {
          "type": "boolean",
          "default": true,
          "title": "Enable tooltip for navigation button",
          "inputType": "Checkbox",
          "validators": []
        },
        "text": {
          "type": "string",
          "title": "",
          "default": "Table of Contents",
          "help": "The tooltip text to display on hover over this item",
          "inputType": "Text",
          "validators": [],
          "translatable": true
        }
      }
    }
  },
  "properties": {
    "pluginLocations": {
      "type": "object",
      "properties": {
        "course": {
          "type": "object",
          "properties": {
            "_toc": {
              "type": "object",
              "legend": "TOC",
              "properties": {
                "_isEnabled": {
                  "type": "boolean",
                  "default": true,
                  "title": "Enable TOC",
                  "inputType": "Checkbox",
                  "validators": []
                },
                "_drawerPosition": {
                  "type": "string",
                  "required": true,
                  "default": "Drawer position",
                  "inputType": "Text",
                  "validators": [],
                  "translatable": false,
                  "help": "The position that the button appears in the drawer. Position options include 'auto', 'left', and 'right'. Defaults to 'auto'"
                },
                "_excludeContentObjects": {
                  "type": "array",
                  "default": [],
                  "title": "Exclusions",
                  "inputType": "List",
                  "_items": {
                    "type": "string"
                  },
                  "help": "Exclude zero or more content objects from the TOC by listing their IDs."
                },
                "_grouping": {
                  "type": "object",
                  "default": {},
                  "title": "Grouping",
                  "inputType": {
                    "type": "CodeEditor",
                    "mode": "json"
                  },
                  "help": "Configure the visual organisation of content objects (see example.json)."
                }
              }
            }
          }
        }
      }
    }
  }
}
